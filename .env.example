# Khóa bí mật của vidagents. Chép thành .env (cùng thư mục với config.json) rồi điền sau dấu =.
# File .env KHÔNG lên git (đã có trong .gitignore). Không dán khóa vào chat, email, Telegram.
# Biến môi trường đặt sẵn trong Windows sẽ được ưu tiên hơn file này.

# Claude API (tính tiền theo token, tách khỏi gói Claude). Bỏ trống nếu đã đăng nhập bằng `ant auth login`.
ANTHROPIC_API_KEY=

# Token bot Telegram lấy ở @BotFather (lệnh /newbot hoặc /token)
TELEGRAM_BOT_TOKEN=
